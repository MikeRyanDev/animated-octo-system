{
  "name": "@frenchfry/core",
  "version": "0.1.0",
  "description": "Framework-agnostic Realtime connection logic for Frenchfry",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hashbrownai/core": "0.5.0-beta.4",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  }
}
